<%- include("../partials/header") %>

<div class="container mt-5">
  <div class="card p-4 col-md-5 mx-auto">
    <h3 class="text-center mb-3">Reset Your Password</h3>

    <form method="POST" action="/force-reset-password">
      <input type="password" name="password" class="form-control mb-3" placeholder="New Password" required>
      <input type="password" name="confirm" class="form-control mb-3" placeholder="Confirm Password" required>
      <button class="btn btn-danger w-100">Update Password</button>
    </form>
  </div>
</div>

<%- include("../partials/footer") %>
